{
  "info": {
    "_postman_id": "nexora-erp-crm-api-collection-2026",
    "name": "NEXORA Operations & Customer Management API",
    "description": "Comprehensive Postman collection for NEXORA Mini ERP + CRM Portal. Covers Authentication, Customer CRM, Follow-ups, Product Catalog, Stock Movements, and Atomic Delivery Challan Transactions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
